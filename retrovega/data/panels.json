   "armour bar: the weakest side",
   "new"
  ],
  "hull_bar": [
   "hull bar: hull points left",
   "new"
  ],
  "power_bar": [
   "power bar: the reactor's load (the power split's draw)",
   "new"
  ],
  "engine_bar": [
   "engine bar: thrust, speed against the most the power split allows",
   "new"
  ],
  "heat": [
   "heat: engine + afterburner + guns, less cooling; what an IR seeker locks on",
   "new"
  ],
  "signature": [
   "signature: how far off the enemy can find and lock you (EMCON, sensor mode, heat, speed)",
   "new"
  ],
  "target_id": [
   "target ID: the target's type and range",
   "new"
  ],
  "aux_nav": [
   "spare display: the nav point and its distance",
   "new"
  ],
  "lock": [
   "LOCK lamp: a missile lock on the target (lock rules follow EMCON, sensor mode, IFF; until missiles exist: the target held in the gunsight)",
   "new"
  ],
  "warn": [
   "MASTER WARN lamp: a damaged system, shields under 25%, a missile inbound; blinks",
   "new"
  ],
  "ab_lamp": [
   "afterburner lamp: lit while burning",
   "new"
  ],
  "nav_lamp": [
   "NAV lamp: nav computer on; blinks while autopilot is available",
   "new"
  ],
  "com_lamp": [
   "COM lamp: a transmission coming in (lit while a comm shows); dark when comms are muted",
   "new"
  ],
  "iff_lamp": [
   "IFF lamp: the IFF on",
   "new"
  ],
  "em_lamp": [
   "E/M lamp: the radar emitting (EMCON ACTIVE)",
   "new"
  ],
