{
 "_": "Every cockpit control made to work (the user, 2026-10-22: every dial, button and light does something, or is blanked; the power-distribution knobs repainted as a radio's frequency dials). functions[fn] = [what it does, status]; cockpits[KEY] = {displays: glass rects (tools/panels.py's lamp search leaves them alone), relabel: [{erase: [x0, y0, x1, y1], labels: [text, cx, cy, px, slant]}], controls: [{fn, kind (lamp, knob, arcs, needle, ticks, bar, text, cabin), arg, at [x, y] + r or rect [x, y, w, h], ...}]}: tools/panels.py makes their states",
 "functions": {
  "lock": [
   "LOCK lamp: a missile lock on the target (until missiles exist: the target held in the gunsight; the lock rules follow EMCON, the sensor mode and IFF)",
   "new"
  ],
  "warn": [
   "MASTER WARN: a damaged system or shields under 25%; blinks",
   "new"
  ],
  "ab_lamp": [
   "afterburner lamp: lit while burning",
   "new"
  ],
  "nav_lamp": [
   "NAV lamp: the nav computer on; blinks while the autopilot is available",
   "new"
  ],
  "com_lamp": [
   "COM lamp: a transmission coming in (lit while a comm shows)",
   "new"
  ],
  "com_on": [
   "COM-on lamp: comms not muted",
   "new"
  ],
  "iff_lamp": [
   "IFF lamp: the IFF on",
   "flag"
  ],
  "em_lamp": [
   "E/M or RADAR lamp: the radar emitting (EMCON ACTIVE)",
   "new"
  ],
  "emcon_lamp": [
   "EMCON lamps: arg 0 OFF, 1 PASSIVE, 2 ACTIVE (the switch's position), 3 STEALTH (anything but ACTIVE)",
   "flag"
  ],
  "sensor_lamp": [
   "sensor mode lamps: arg 0 radar (NORMAL / ACTIVE: radar-guided, friend-or-foe locks), 1 infrared (PASSIVE: IR locks on hot targets only)",
   "flag"
  ],
  "target_lamp": [
   "TARGET lamp: a target chosen",
   "new"
  ],
  "status_lamp": [
   "status lamps, lit when that system is low or damaged: arg 0 shields, 1 armour, 2 hull, 3 fuel, 4 power plant, 5 engine",
   "new"
  ],
  "mfd_lamp": [
   "MFD bezel lamps: lit while that MFD works (arg 0 left, 1 right); dark when it is damaged",
   "new"
  ],
  "surv_page": [
   "survival display buttons: lit on the page shown (arg: 0 shields + armour, 1 hull + systems, 2 nav)",
   "new"
  ],
  "radio_chan": [
   "radio channel lamps / buttons: lit on the channel tuned (arg 0 WING, 1 CARRIER, 2 GUARD)",
   "new"
  ],
  "arm_lamp": [
   "master arm lamp: the guns armed (safe on the deck)",
   "flag"
  ],
  "auto_lamp": [
   "AUTO lamps: arg 0 autopilot available, 1 match the target's speed, 2 keep the nearest enemy targeted, 3 decoys dropped on a missile lock",
   "flag"
  ],
  "defence": [
   "DEFENCE lamp: decoys left",
   "flag"
  ],
  "sig_ladder": [
   "a column of lamps: the signature (arg: the lamp, 0 the bottom; lit while the signature is above it)",
   "new"
  ],
  "range_ladder": [
   "a column of lamps: the radar range (arg: the lamp, 0 the bottom)",
   "new"
  ],
  "cabin": [
   "every other lamp: the running lights, dark under EMCON OFF and with the power plant damaged, a flicker when hit",
   "new"
  ],
  "radio_digit": [
   "COMM FREQ knobs (the kits painted POWER DISTRIB; the user's pick): the frequency a digit a knob (arg 0 hundreds, 1 tens, 2 units of MHz), turning to whoever talks: WING 267, the carrier 315, GUARD 243 (the real military distress frequency: where an enemy hails you)",
   "new"
  ],
  "radio_lit": [
   "the scales over the frequency knobs: dim, lit while a transmission is coming in",
   "new"
  ],
  "chan_knob": [
   "a channel knob: WING / CARRIER / GUARD",
   "new"
  ],
  "emcon_knob": [
   "an E/M knob: EMCON OFF / PASSIVE / ACTIVE",
   "flag"
  ],
  "nav_knob": [
   "a NAV knob: the nav point chosen (four positions)",
   "new"
  ],
  "iff_knob": [
   "an IFF knob: off / on",
   "flag"
  ],
  "radar_knob": [
   "a radar knob: the range, 4,000 / 8,000 / 16,000 km",
   "new"
  ],
  "arm_knob": [
   "a WPN knob: safe / armed",
   "flag"
  ],
  "vol_knob": [
   "a VOL knob: muted / on (comms)",
   "new"
  ],
  "speed_dial": [
   "an analog speed dial: a needle at the speed (its painted needle painted out)",
   "new"
  ],
  "clock_dial": [
   "a two-hand dial: the mission clock (minutes and seconds)",
   "new"
  ],
  "shield_bar": [
